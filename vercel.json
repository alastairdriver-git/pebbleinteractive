{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter pebbleinteractive-site build",
  "outputDirectory": "site/dist",
  "headers": [
    {
      "source": "/case-studies/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/case-studies",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/og-cards/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/figure-cards/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/carousel-cards/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/a2ui-in-one-page",
      "destination": "/products/a2ui-starter-guide",
      "permanent": true
    },
    {
      "source": "/products/a2ui-in-one-page.md",
      "destination": "/products/a2ui-starter-guide.md",
      "permanent": true
    },
    {
      "source": "/downloads/a2ui-in-one-page.pdf",
      "destination": "/downloads/a2ui-starter-guide.pdf",
      "permanent": true
    }
  ]
}