---
/* Newsletter sign-up. Posts straight to Substack's free-subscribe endpoint,
   so it needs no script. Renders nothing until NEWSLETTER.url is set in
   src/lib/site.config.ts. */
import { NEWSLETTER } from "../lib/site.config";

interface Props {
  heading?: string;
  body?: string;
  /** "panel" = boxed block (articles, products); "band" = for the dark band. */
  variant?: "panel" | "band";
}
const {
  heading = `Get ${NEWSLETTER.name} by email`,
  body = `${NEWSLETTER.promise} Subscribers get the free design system health check.`,
  variant = "panel",
} = Astro.props;
const action = NEWSLETTER.url ? `${NEWSLETTER.url.replace(/\/$/, "")}/api/v1/free?nojs=true` : "";
---

{action && (
  <aside class={`subscribe subscribe--${variant}`} aria-labelledby="subscribe-heading">
    <div>
      <h2 id="subscribe-heading" class="text-balance font-display text-2xl tracking-tight sm:text-3xl">{heading}</h2>
      <p class="mt-3 max-w-prose text-pretty">{body}</p>
    </div>
    <form action={action} method="post" target="_blank" class="subscribe-form">
      <label for="subscribe-email" class="sr-only">Email address</label>
      <input id="subscribe-email" type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
      <button type="submit">Subscribe</button>
    </form>
    <p class="subscribe-note">Free. Unsubscribe any time. Sent via Substack.</p>
  </aside>
)}
