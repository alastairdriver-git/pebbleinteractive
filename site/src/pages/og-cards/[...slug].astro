---
/* Social card (1200×630) for every case study, article and product. Not linked anywhere: `pnpm og` screenshots each of these
   into public/og/<slug>.png, which the pages then use as their og:image.
   Edit this file to change how every thumbnail looks. */
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const work = (await getCollection("work")).map((e) => ({
    params: { slug: `work/${e.id}` },
    props: { eyebrow: e.data.category, title: e.data.title, kicker: e.data.client, image: e.data.thumb },
  }));
  // Every article and product, drafts included, so thumbnails exist before publishing.
  const articles = (await getCollection("articles")).map((e) => ({
    params: { slug: `articles/${e.id}` },
    props: { eyebrow: e.data.series, title: e.data.title, kicker: "Article", image: e.data.image },
  }));
  const products = (await getCollection("products")).map((e) => ({
    params: { slug: `products/${e.id}` },
    props: { eyebrow: e.data.format, title: e.data.title, kicker: "Product", image: e.data.image },
  }));
  return [...work, ...articles, ...products];
}

const { eyebrow, title, kicker, image } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,200..900&display=swap">
<style>
  * { margin: 0; box-sizing: border-box; }
  html, body { width: 1200px; height: 630px; overflow: hidden; }
  .card {
    width: 1200px; height: 630px; position: relative; overflow: hidden;
    background: oklch(0.245 0.045 220); color: oklch(0.965 0.006 85);
    font-family: "Mona Sans", system-ui, sans-serif;
    display: grid; grid-template-columns: 1fr 470px;
  }
  .text { display: flex; flex-direction: column; justify-content: space-between; padding: 64px 48px 56px 72px; }
  .eyebrow { font-size: 21px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: oklch(0.82 0.09 195); font-variation-settings: "wdth" 115; }
  .kicker { margin-top: 28px; font-size: 30px; font-weight: 600; opacity: .8; font-variation-settings: "wdth" 110; }
  h1 { margin-top: 10px; font-size: 54px; line-height: 1.06; letter-spacing: -0.02em; font-weight: 650; font-variation-settings: "wdth" 115; text-wrap: balance; }
  .brand { display: flex; align-items: center; gap: 14px; font-size: 26px; font-weight: 650; font-variation-settings: "wdth" 110; }
  .brand svg { width: 46px; height: 38px; }
  .media { position: relative; margin: 56px 56px 56px 0; border-radius: 14px; overflow: hidden; background: oklch(0.3 0.04 220); }
  .media img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  /* No image: the title takes the full width, larger. */
  .card.text-only { grid-template-columns: 1fr; }
  .card.text-only .text { padding: 72px 96px 64px 72px; }
  .card.text-only h1 { font-size: 72px; max-width: 18ch; }
  .card.text-only::after {
    content: ""; position: absolute; right: -120px; top: -120px; width: 460px; height: 460px; border-radius: 50%;
    background: oklch(0.82 0.09 195 / .14);
  }
</style>
</head>
<body>
  <div class={image ? "card" : "card text-only"}>
    <div class="text">
      <div>
        <div class="eyebrow">{eyebrow}</div>
        <div class="kicker">{kicker}</div>
        <h1>{title}</h1>
      </div>
      <div class="brand">
        <svg viewBox="0 0 125 102" aria-hidden="true">
          <path fill="oklch(0.82 0.09 195)" d="M60 2 C95 -3 122 18 124 48 C126 78 100 100 62 101 C26 102 -2 82 0 50 C2 20 28 7 60 2 Z"/>
          <rect x="-20" y="58" width="180" height="12" fill="oklch(0.245 0.045 220)" transform="rotate(-7 62 64)"/>
        </svg>
        Pebble Interactive
      </div>
    </div>
    {image && <div class="media"><img src={image} alt="" /></div>}
  </div>
</body>
</html>
