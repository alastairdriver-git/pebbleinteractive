---
import "../../styles/global.css";
import { getEntries, render } from "astro:content";
import BaseLayout from "@grade/astro-kit/BaseLayout.astro";
import { Section, Container } from "@gradeui/ui";
import { SITE, NAV, FONT_HREF, AUTHOR } from "../../lib/site.config";
import JsonLd from "../../components/JsonLd.astro";
import WorkCards from "../../components/WorkCards.astro";
import ProductCards from "../../components/ProductCards.astro";
import Subscribe from "../../components/Subscribe.astro";
import A2uiDemoMount from "../../components/A2uiDemoMount";
import { getArticles, SHOW_DRAFTS, formatDate, readingTime, wordCount } from "../../lib/content";
import { graph, organization, founder, website, webPage, article, breadcrumbs } from "../../lib/seo";

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[i + 1] ?? all[0] } }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasDemo = (entry.body ?? "").includes("{{a2ui ");
const path = `/articles/${entry.id}`;
/* Social image: generated by `pnpm og` into public/og/articles/<slug>.png unless ogImage is set. */
const og = d.ogImage ?? `/og/articles/${entry.id}.png`;
const related = d.related.length ? await getEntries(d.related) : [];
const products = (d.products.length ? await getEntries(d.products) : []).filter(
  (p) => SHOW_DRAFTS || p.data.status !== "draft",
);
const ld = graph(
  organization(),
  founder(),
  website(),
  webPage({ path, name: d.title, description: d.description }),
  article(entry.id, d, { image: og, wordCount: wordCount(entry.body), related: d.related.map((r) => r.id) }),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Articles", path: "/articles" },
    { name: d.title, path },
  ]),
);
---

<BaseLayout site={SITE} nav={NAV} fontHref={FONT_HREF} title={`${d.title} — Pebble Interactive`} description={d.description} image={og}>
  <JsonLd slot="head" data={ld} />
  <meta slot="head" property="article:published_time" content={d.pubDate.toISOString()} />
  {d.updated && <meta slot="head" property="article:modified_time" content={d.updated.toISOString()} />}
  <meta slot="head" property="article:author" content={AUTHOR.name} />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Pebble Interactive articles" href="/rss.xml" />
  {d.draft && <meta slot="head" name="robots" content="noindex" />}

  <div class="reading-progress" aria-hidden="true"></div>
  <Section pad="lg">
    <Container maxW="xl">
      <div class="article-shell">
      <nav aria-label="Breadcrumb" class="work-crumbs">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/articles">Articles</a>
      </nav>
      <header class="article-head">
        {d.draft && <p class="article-draft">Draft: not published</p>}
        <span class="article-series">{d.series}</span>
        <h1 class="text-balance font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl">{d.title}</h1>
        <p class="text-pretty text-xl leading-[1.45] text-muted-foreground">{d.description}</p>
        <p class="article-byline">
          <span><a href={AUTHOR.url} rel="author">{AUTHOR.name}</a>, {AUTHOR.role}</span>
          <span aria-hidden="true">·</span>
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(entry.body)} min read</span>
        </p>
      </header>
      {d.image && <figure class="article-hero"><img src={d.image} alt={d.imageAlt ?? ""} /></figure>}
      <div class="article-body article-prose">
        <Content />
      </div>
      </div>
    </Container>
  </Section>

  {related.length > 0 && (
    <Section pad="lg">
      <Container maxW="xl">
        <span class="eyebrow">From the case {related.length > 1 ? "studies" : "study"}</span>
        <div class="mt-8"><WorkCards items={related} /></div>
      </Container>
    </Section>
  )}

  <Section pad="lg">
    <Container maxW="xl">
      <Subscribe />
      {products.length > 0 && (
        <div class="mt-16">
          <span class="eyebrow">Related {products.length > 1 ? "products" : "product"}</span>
          <div class="mt-8"><ProductCards items={products} /></div>
        </div>
      )}
      {next && next.id !== entry.id && (
        <a href={`/articles/${next.id}`} class="work-next mt-16">
          <span class="eyebrow">Next article</span>
          <span class="mt-3 block text-balance font-display text-3xl tracking-tight sm:text-4xl">{next.data.title} →</span>
        </a>
      )}
      <p class="mt-8"><a href="/articles" class="work-all">All articles</a></p>
    </Container>
  </Section>
  {hasDemo && <A2uiDemoMount client:only="react" />}
</BaseLayout>
