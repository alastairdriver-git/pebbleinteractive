---
import "../../styles/global.css";
import BaseLayout from "@grade/astro-kit/BaseLayout.astro";
import { Section, Container } from "@gradeui/ui";
import { SITE, NAV, FONT_HREF } from "../../lib/site.config";
import JsonLd from "../../components/JsonLd.astro";
import ArticleCards from "../../components/ArticleCards.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getArticles } from "../../lib/content";
import { graph, organization, website, webPage, articleList, breadcrumbs } from "../../lib/seo";

const all = await getArticles();
const description =
  "Articles from Pebble Interactive on design systems, AI in the design process and editing AI output, drawn from real client work.";
const ld = graph(
  organization(),
  website(),
  webPage({ path: "/articles", name: "Articles", description, type: "CollectionPage" }),
  articleList(all.map((a) => ({ slug: a.id, title: a.data.title }))),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Articles", path: "/articles" },
  ]),
);
---

<BaseLayout site={SITE} nav={NAV} fontHref={FONT_HREF} title="Articles — Pebble Interactive" description={description} image="/og.png">
  <JsonLd slot="head" data={ld} />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Pebble Interactive articles" href="/rss.xml" />
  {all.length === 0 && <meta slot="head" name="robots" content="noindex" />}

  <Section pad="lg">
    <Container maxW="xl">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Articles</span>
        <h1 class="max-w-4xl text-balance font-display text-4xl leading-[1.05] tracking-tight sm:text-6xl">Notes from the work</h1>
        <p class="max-w-3xl text-pretty text-xl leading-relaxed text-muted-foreground">
          Design systems, AI in the design process and editing what AI makes, each drawn from a real project.
        </p>
      </div>
      <div class="mt-14">
        {all.length ? <ArticleCards items={all} /> : <p class="text-lg text-muted-foreground">The first articles are on their way.</p>}
      </div>
      <div class="mt-16"><Subscribe /></div>
    </Container>
  </Section>
</BaseLayout>
