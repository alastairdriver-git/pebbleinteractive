---
import "../../styles/global.css";
import { getCollection } from "astro:content";
import BaseLayout from "@grade/astro-kit/BaseLayout.astro";
import { Section, Container } from "@gradeui/ui";
import { SITE, NAV, FONT_HREF } from "../../lib/site.config";
import JsonLd from "../../components/JsonLd.astro";
import WorkMedia from "../../components/WorkMedia.astro";
import { graph, organization, website, webPage, caseStudy, breadcrumbs } from "../../lib/seo";

export async function getStaticPaths() {
  const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: all[(i + 1) % all.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const path = `/work/${entry.id}`;
/* Social image: generated by `pnpm og` into public/og/work/<slug>.png unless ogImage is set. */
const og = d.ogImage ?? `/og/work/${entry.id}.png`;
const facts: [string, string][] = [
  ["Client", d.client],
  ["Sector", d.sector],
  ["Period", d.period],
  ["Role", d.role],
];
const ld = graph(
  organization(),
  website(),
  webPage({ path, name: `${d.client}: ${d.title}`, description: d.intro }),
  caseStudy(entry.id, { ...d, ogImage: og }),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Work", path: "/work" },
    { name: d.client, path },
  ]),
);
---

<BaseLayout
  site={SITE}
  nav={NAV}
  fontHref={FONT_HREF}
  title={`${d.client}: ${d.title} — Pebble Interactive`}
  description={d.intro}
  image={og}
>
  <JsonLd slot="head" data={ld} />

  {/* Header */}
  <Section pad="lg">
    <Container maxW="xl">
      <nav aria-label="Breadcrumb" class="work-crumbs">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/work">Work</a><span aria-hidden="true">/</span><span>{d.client}</span>
      </nav>
      <div class="mt-10 flex flex-col gap-5">
        <span class="eyebrow">{d.category}</span>
        <h1 class="max-w-4xl text-balance font-display text-4xl leading-[1.05] tracking-tight sm:text-6xl">{d.title}</h1>
        <p class="max-w-3xl text-pretty text-xl leading-[1.45] text-muted-foreground">{d.intro}</p>
      </div>
      <dl class="work-facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <div class="work-hero"><WorkMedia m={d.hero} /></div>
    </Container>
  </Section>

  <Section pad="lg">
    <Container maxW="xl">
      {/* The brief */}
      <section class="work-block">
        <h2 class="work-label">The brief</h2>
        <div class="work-block-body"><p class="work-lead">{d.brief}</p></div>
      </section>

      {/* What we did */}
      <section class="work-block">
        <h2 class="work-label">What we did</h2>
        <div class="work-block-body">
          {d.workstreams.map((w) => (
            <div class="work-stream">
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              {(w.image || w.video) && <WorkMedia m={w} />}
            </div>
          ))}
        </div>
      </section>

      {/* Outcome */}
      <section class="work-block">
        <h2 class="work-label">Outcome</h2>
        <div class="work-block-body">
          <p class="work-lead">{d.outcome}</p>
          {d.metrics && (
            <div class="work-metrics">
              {d.metrics.map((m) => (<div><strong>{m.value}</strong><span>{m.label}</span></div>))}
            </div>
          )}
        </div>
      </section>

      {d.testimonial && (
        <figure class="work-quote">
          <blockquote>“{d.testimonial.quote}”</blockquote>
          <figcaption><strong>{d.testimonial.name}</strong>, {d.testimonial.role}</figcaption>
        </figure>
      )}
    </Container>
  </Section>

  {/* What this demonstrates */}
  <div class="bg-camel">
    <Section pad="lg">
      <Container maxW="xl">
        <h2 class="font-display text-3xl tracking-tight sm:text-4xl">What this demonstrates</h2>
        <dl class="work-demo">
          {d.demonstrates.map((x) => (<div><dt>{x.skill}</dt><dd>{x.evidence}</dd></div>))}
        </dl>
      </Container>
    </Section>
  </div>

  <Section pad="lg">
    <Container maxW="xl">
      <p class="work-link"><a href={d.link.href} target="_blank" rel="noopener">{d.link.label} →</a></p>
      <a href={`/work/${next.id}`} class="work-next">
        <span class="eyebrow">Next case study</span>
        <span class="mt-3 block text-balance font-display text-3xl tracking-tight sm:text-4xl">{next.data.client}: {next.data.title} →</span>
      </a>
      <p class="mt-8"><a href="/work" class="work-all">All work</a></p>
    </Container>
  </Section>
</BaseLayout>
