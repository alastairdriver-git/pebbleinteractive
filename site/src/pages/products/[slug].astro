---
/* Product page, generated from the product's brief (frontmatter in
   src/content/products). It sells the outcome first: what the buyer will be
   able to do, then why it works, video, previews, what's inside, who it's
   for and FAQs. */
import "../../styles/global.css";
import { render } from "astro:content";
import BaseLayout from "@grade/astro-kit/BaseLayout.astro";
import { Section, Container } from "@gradeui/ui";
import * as Icons from "lucide-react";
import { SITE, NAV, FONT_HREF } from "../../lib/site.config";
import JsonLd from "../../components/JsonLd.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getProducts, formatPrice } from "../../lib/content";
import { graph, organization, website, webPage, product, breadcrumbs, SITE_URL } from "../../lib/seo";

export async function getStaticPaths() {
  return (await getProducts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/products/${entry.id}`;
const og = `/og/products/${entry.id}.png`;
const live = d.status === "live";
const free = d.price === 0;
const price = live ? formatPrice(d.price, d.currency) : "Coming soon";
const icon = (name: string) => (Icons as any)[name] ?? Icons.Circle;
const inside = d.inside.length ? d.inside : d.includes.map((t) => ({ icon: "Check", title: t, body: "" }));

const nodes: object[] = [
  organization(),
  website(),
  webPage({ path, name: d.headline ?? d.title, description: d.summary }),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Products", path: "/products" },
    { name: d.title, path },
  ]),
];
if (live) nodes.push(product(entry.id, d, d.image ?? og));
if (d.faqs.length)
  nodes.push({
    "@type": "FAQPage",
    "@id": `${SITE_URL}${path}#faq`,
    mainEntity: d.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
const ld = graph(...nodes);
/* Lemon Squeezy: overlay checkout when lemon.js loads; otherwise the hosted checkout. */
const checkout = d.checkoutUrl ? `${d.checkoutUrl}${d.checkoutUrl.includes("?") ? "&" : "?"}embed=1` : undefined;
const notify = `mailto:hello@pebbleinteractive.com?subject=${encodeURIComponent(`Tell me when ${d.title} is out`)}`;
const cta = live && checkout ? { href: checkout, label: `Buy now · ${price}`, cls: "lemonsqueezy-button" }
  : live && free && d.downloadUrl ? { href: d.downloadUrl, label: "Download free", cls: "" }
  : null;
---

<BaseLayout site={SITE} nav={NAV} fontHref={FONT_HREF} title={`${d.title} — Pebble Interactive`} description={d.summary} image={d.image ?? og}>
  <JsonLd slot="head" data={ld} />
  {d.status === "draft" && <meta slot="head" name="robots" content="noindex" />}

  {/* Hero: the outcome, the price, the action */}
  <div class="bg-camel product-hero">
    <Section pad="lg">
      <Container maxW="xl">
        <nav aria-label="Breadcrumb" class="work-crumbs product-crumbs">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/products">Products</a>
        </nav>
        <div class="product-hero-grid">
          <div class="flex flex-col gap-6">
            {d.status === "draft" && <p class="article-draft">Draft: not listed</p>}
            <span class="product-pill">{d.format}{free && live ? " · Free" : ""}</span>
            <h1 class="product-title text-balance font-display text-4xl sm:text-5xl">{d.headline ?? d.title}</h1>
            <p class="max-w-2xl text-pretty text-xl leading-relaxed opacity-85">{d.headline ? `${d.title}. ${d.summary}` : d.summary}</p>
            <div class="product-hero-actions">
              {cta ? <a href={cta.href} class={`product-cta ${cta.cls}`} download={free ? true : undefined}>{cta.label}</a>
                   : <a href={notify} class="product-cta">Email me when it's out</a>}
              {!free && live && <span class="product-hero-note">Instant download. VAT handled at checkout.</span>}
              {free && live && <span class="product-hero-note">No sign-up needed.</span>}
              {!live && <span class="product-hero-note">Coming soon</span>}
            </div>
          </div>
          {d.image && <img src={d.image} alt={d.imageAlt ?? ""} class="product-hero-image" />}
        </div>
      </Container>
    </Section>
  </div>

  <Section pad="lg">
    <Container maxW="xl">
      {d.problem && (
        <section class="product-problem">
          <span class="eyebrow">The problem</span>
          <p class="text-balance font-display text-2xl leading-snug tracking-tight sm:text-3xl">{d.problem}</p>
        </section>
      )}

      {d.outcomes.length > 0 && (
        <section class="product-section">
          <h2 class="product-h2">What you'll be able to do</h2>
          <ul class="product-outcomes">
            {d.outcomes.map((o) => (<li><span class="product-tick" aria-hidden="true"><Icons.Check size={18} strokeWidth={3} /></span>{o}</li>))}
          </ul>
        </section>
      )}

      {d.highlights.length > 0 && (
        <section class="product-section">
          <h2 class="product-h2">Why it works</h2>
          <div class="product-highlights">
            {d.highlights.map((h) => { const I = icon(h.icon); return (
              <div class="product-highlight"><span class="product-icon" aria-hidden="true"><I size={22} strokeWidth={2} /></span><h3>{h.title}</h3><p>{h.body}</p></div>
            ); })}
          </div>
        </section>
      )}

      {d.video && (
        <section class="product-section">
          <h2 class="product-h2">See it in a minute</h2>
          <video class="product-video" src={d.video.src} poster={d.video.poster} controls preload="metadata" playsinline></video>
        </section>
      )}

      {d.previews.length > 0 && (
        <section class="product-section">
          <h2 class="product-h2">Take a look inside</h2>
          <div class="product-previews">
            {d.previews.map((p) => (<figure><img src={p.src} alt={p.alt} loading="lazy" /><figcaption>{p.alt}</figcaption></figure>))}
          </div>
        </section>
      )}

      <section class="product-section">
        <h2 class="product-h2">What's inside</h2>
        <div class="product-inside">
          {inside.map((x) => { const I = icon(x.icon); return (
            <div><span class="product-icon small" aria-hidden="true"><I size={18} strokeWidth={2} /></span><div><strong>{x.title}</strong>{x.body && <span>{x.body}</span>}</div></div>
          ); })}
        </div>
        {d.inside.length > 0 && d.includes.length > 0 && (
          <ul class="product-includes">{d.includes.map((i) => <li>{i}</li>)}</ul>
        )}
      </section>

      <section class="product-section product-for">
        <h2 class="product-h2">Who it's for</h2>
        <p class="work-lead">{d.forWho}</p>
        <div class="es-prose product-about"><Content /></div>
      </section>

      {d.faqs.length > 0 && (
        <section class="product-section">
          <h2 class="product-h2">Questions</h2>
          <div class="product-faqs">
            {d.faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
          </div>
        </section>
      )}
    </Container>
  </Section>

  <div class="bg-camel">
    <Section pad="lg">
      <Container maxW="xl">
        <div class="product-final">
          <div>
            <span class="eyebrow">{d.title}</span>
            <p class="mt-3 text-balance font-display text-3xl tracking-tight sm:text-4xl">{d.headline ?? d.summary}</p>
          </div>
          {cta ? <a href={cta.href} class={`product-cta ${cta.cls}`} download={free ? true : undefined}>{cta.label}</a>
               : <a href={notify} class="product-cta">Email me when it's out</a>}
        </div>
      </Container>
    </Section>
  </div>

  <Section pad="lg">
    <Container maxW="xl">
      <div id="subscribe"><Subscribe /></div>
      <p class="mt-12"><a href="/products" class="work-all">All products</a></p>
    </Container>
  </Section>

  {live && checkout && <script is:inline src="https://assets.lemonsqueezy.com/lemon.js" defer></script>}
</BaseLayout>
