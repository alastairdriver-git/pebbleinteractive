---
import "../../styles/global.css";
import BaseLayout from "@grade/astro-kit/BaseLayout.astro";
import { Section, Container } from "@gradeui/ui";
import { SITE, NAV, FONT_HREF } from "../../lib/site.config";
import JsonLd from "../../components/JsonLd.astro";
import ProductCards from "../../components/ProductCards.astro";
import Subscribe from "../../components/Subscribe.astro";
import { getProducts } from "../../lib/content";
import { graph, organization, website, webPage, productList, breadcrumbs } from "../../lib/seo";

const all = await getProducts();
const live = all.filter((p) => p.data.status === "live");
const description =
  "Templates, guides and kits from Pebble Interactive for design systems, procurement and case studies. Instant download.";
const ld = graph(
  organization(),
  website(),
  webPage({ path: "/products", name: "Products", description, type: "CollectionPage" }),
  productList(live.map((p) => ({ slug: p.id, title: p.data.title }))),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Products", path: "/products" },
  ]),
);
---

<BaseLayout site={SITE} nav={NAV} fontHref={FONT_HREF} title="Products — Pebble Interactive" description={description} image="/og.png">
  <JsonLd slot="head" data={ld} />
  {all.length === 0 && <meta slot="head" name="robots" content="noindex" />}

  <Section pad="lg">
    <Container maxW="xl">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Products</span>
        <h1 class="max-w-4xl text-balance font-display text-4xl leading-[1.05] tracking-tight sm:text-6xl">Templates and guides from real work</h1>
        <p class="max-w-3xl text-pretty text-xl leading-relaxed text-muted-foreground">
          The documents, templates and checklists we use ourselves, made generic so you can use them too. Instant download.
        </p>
      </div>
      <div class="mt-14">
        {all.length ? <ProductCards items={all} /> : <p class="text-lg text-muted-foreground">The first products are on their way.</p>}
      </div>
      <div class="mt-16"><Subscribe heading="Hear when new products launch" body="Subscribers hear first, with a launch discount, and get the free design system health check." /></div>
    </Container>
  </Section>
</BaseLayout>
